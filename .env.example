# Upstash Redis —— Upstash 控制台 > Redis > 你的库 > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash —— Upstash 控制台 > QStash > 点进 US Region > 页面里的密钥区
# QSTASH_URL 必须是所选 region 的专属地址。US East 1 是下面这个；
# 用默认的 https://qstash.upstash.io 会报 "user not found in this region"。
# 控制台复制按钮给的值自带双引号，粘贴后记得把引号删掉。
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Web Push VAPID —— 用 `npx web-push generate-vapid-keys` 生成
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 打卡页口令与 cookie 签名密钥（签名密钥用 `openssl rand -hex 32` 生成）
PUNCH_PASSCODE=
PUNCH_SESSION_SECRET=

# QStash 回调要打回来的公网地址，本地开发填 ngrok 地址，生产填 Vercel 域名
APP_URL=http://localhost:3000
